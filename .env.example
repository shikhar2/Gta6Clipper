# ===== Copy this file to .env and fill it in:  cp .env.example .env  =====
# Never share this file or paste it in any chat.

# --- Twitch (dev.twitch.tv/console -> your app -> Manage) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Telegram (token from @BotFather; chat id from: python -m clipper chatid) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- What to watch ---
# Before launch, test with:  GAME_NAME=Grand Theft Auto V
GAME_NAME=Grand Theft Auto VI
DISCOVERY=true          # alert me about new small streamers
MIN_VIEWERS=20
MAX_VIEWERS=500
LANGUAGES=en,hi         # stream languages to look for (Twitch language codes)
ALERTS_PER_CYCLE=5      # max new-streamer alerts per minute
MAX_SESSIONS=4          # how many streams to record at once (4 CPU server: 3-4)

# --- Clips ---
CLIP_BEFORE=30          # seconds before the moment
CLIP_AFTER=10           # seconds after the moment
COOLDOWN=60             # min seconds between clips of the same stream
CHAT_MULTIPLIER=3.0     # chat must be 3x faster than normal to count as a moment
AUDIO_JUMP_DB=9         # how much louder than normal = a moment (YouTube, no chat)
AUDIO_JUMP_DB_WITH_CHAT=12

# --- Subtitles ---
CAPTIONS=true
WHISPER_MODEL=small     # tiny / base / small  (small = best on a 4-CPU server)
# Language of speech: leave empty to auto-detect, or set en / hi
WHISPER_LANGUAGE=
